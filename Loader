-- ===== Detect current game =====
local function isCurrent(g)
	for _, id in ipairs(g.PlaceIds or {}) do
		if id == game.PlaceId then return true end
	end
	return false
end

local detected
for _, g in ipairs(GAMES) do
	g.Detected = isCurrent(g)
	if g.Detected and not detected then detected = g end
end

-- ===== Helpers =====
local function new(class, props, children)
	local o = Instance.new(class)
	for k, v in pairs(props or {}) do o[k] = v end
	for _, c in ipairs(children or {}) do c.Parent = o end
	return o
end
local function corner(r) return new("UICorner", {CornerRadius = UDim.new(0, r)}) end
local function tween(o, t, props) TweenService:Create(o, TweenInfo.new(t, Enum.EasingStyle.Quad), props):Play() end

local function notify(text)
	pcall(function()
		StarterGui:SetCore("SendNotification", {Title = "Project Apex", Text = text, Duration = 5})
	end)
end

