-- ===== Load =====
local loading = false
loadBtn.MouseButton1Click:Connect(function()
	if loading then return end
	if not selected then
		setStatus("Select a game first!", Color3.fromRGB(255, 110, 110))
		return
	end
	local g = selected
	if not g.Detected then
		local where = detected and ("You are in " .. detected.Name .. ", not " .. g.Name .. ".") or "You are not in a supported game."
		toast("Wrong game", "You are not in " .. g.Name .. "." .. (detected and (" You are in " .. detected.Name .. ".") or ""), Color3.fromRGB(255, 110, 110))
		setStatus(where, Color3.fromRGB(255, 110, 110))
		return
	end
	loading = true
	loadBtn.Text = "Loading..."
	setStatus("Downloading " .. g.Name .. "...", ACCENT)

	local okGet, src = pcall(function() return game:HttpGet(g.Url) end)
	if not okGet or type(src) ~= "string" or #src == 0 then
		setStatus("Download failed. Try again.", Color3.fromRGB(255, 110, 110))
		loadBtn.Text = "Load Script"
		loading = false
		return
	end
	local fn, compileErr = loadstring(src)
	if not fn then
		setStatus("Script error: " .. tostring(compileErr):sub(1, 60), Color3.fromRGB(255, 110, 110))
		loadBtn.Text = "Load Script"
		loading = false
		return
	end

	-- close the loader so the key system / script UI is visible
	tween(main, 0.25, {Size = UDim2.fromOffset(380, 0)})
	task.wait(0.25)
	gui:Destroy()
	G.ProjectApexLoader = nil

	notify("Loading " .. g.Name .. "...")
	task.spawn(function()
		local okRun, err = pcall(fn)
		if not okRun then
			warn("[Project Apex] " .. g.Name .. " error: " .. tostring(err))
			notify(g.Name .. " failed to load (check console F9)")
		end
	end)
end)

